{
  "permissions": {
    "allow": [
      "Bash(cmake -S . -B build*)",
      "Bash(cmake --build*)",
      "Bash(ctest --test-dir build*)",
      "Bash(pio run*)",
      "Bash(pio test*)",
      "Bash(./build/mal_tests*)",
      "Bash(./build/dump_frame*)",
      "Bash(python3 tools/gen_assets.py)",
      "Bash(bash tools/run.sh)",
      "Bash(git status*)",
      "Bash(git --no-pager diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-stop-reminder.sh\""
          }
        ]
      }
    ]
  }
}
