# Build output
/build/
/.pio/
compile_commands.json
/out.png

# Editor / LSP index caches (clangd writes .cache/clangd from compile_commands)
.cache/

# Generated assets (regenerate with: python3 tools/gen_assets.py)
/src/generated/

# Host preview dumps
*.ppm
*.bmp

# Host persistence file (FileSaveStore writes the save blob to the cwd)
/malwarium_save.bin

# Generated preview-panel snapshot gallery (regenerated by tools/run.sh)
/tools/preview_page/*.png

# NOTE: include/config.h is COMMITTED — it holds the verified device pinout
# (the bring-up result), now authoritative rather than a per-machine template.

# Claude Code: personal/local settings. launch.json is here because a preview server
# needs an ABSOLUTE cwd — the launcher resolves neither a relative path nor
# $CLAUDE_PROJECT_DIR — so the file can only ever describe one machine.
.claude/settings.local.json
.claude/launch.json
# Local slash-command defs (kept out of the repo by decision — not shared tooling)
.claude/commands/

# Python tooling
.venv/
__pycache__/

# macOS
.DS_Store
/dist/

# Art with no consumer, parked out of the compiled atlas (see assets/_attic/README.md).
/assets/_attic/
