# Which web 'Pedia bundle this is. `code` is the packed monotonic integer an
# update check compares; `version` is the string it displays. Bump both when
# publishing a bundle, the same way include/version.h stamps the firmware — the
# two version independently, which is why the manifest lists them as separate
# artifacts.
#
# `code` packs the version the way the firmware's does (packVersion,
# include/version.h): MAJOR * 1000000 + MINOR * 1000 + PATCH, three digits each for
# MINOR and PATCH. Which part a publish moves is decided there too.
#
# Nobody edits these by hand day to day: `tools/serve_updates.sh --bump web`
# rewrites both from the part you name.
#
# `make pedia-sd` stages this file alongside the bundle; an on-device update
# rewrites it (src/platform/esp32/web_bundle.h). Parser: src/core/net/version_marker.h.
code=9023
version=0.9.23
